{
  "name": "link-tree",
  "version": "2.0.0",
  "description": "Privacy-first, static-first link-in-bio platform for churches, mission organizations, and non-profits",
  "license": "MIT",
  "homepage": "https://kirche-echo.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/subinamathew/link-tree.git"
  },
  "keywords": [
    "church",
    "mission",
    "non-profit",
    "link-in-bio",
    "linktree",
    "privacy-first",
    "dsgvo",
    "gdpr",
    "eleventy",
    "storyblok"
  ],
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "test": "node --test",
    "build:sass": "sass src/styles/main.scss _site/css/main.css --style=compressed --no-source-map",
    "build:eleventy": "eleventy",
    "build": "npm run validate && npm run build:sass && npm run build:eleventy && node scripts/verify-build.mjs",
    "dev:sass": "sass src/styles/main.scss _site/css/main.css --watch --style=expanded",
    "dev:eleventy": "eleventy --serve",
    "dev": "npm run build:sass && eleventy --serve",
    "storyblok:push": "storyblok push-components storyblok/components.json",
    "storyblok:pull": "storyblok pull-components"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "nunjucks": "^3.2.4",
    "sass": "^1.83.4",
    "storyblok": "^3.36.0"
  }
}
