{% set rawTheme = (storyblok.content.theme.value if (storyblok and storyblok.content and storyblok.content.theme and storyblok.content.theme.value) else (storyblok.content.theme if (storyblok and storyblok.content) else site.theme)) or 'light' %}
{% set rawSurface = surface or (storyblok.content.surface.value if (storyblok and storyblok.content and storyblok.content.surface and storyblok.content.surface.value) else (storyblok.content.surface if (storyblok and storyblok.content) else 'default')) or 'default' %}
{% set currentTheme = rawTheme | sanitizeTheme %}
{% set currentSurface = rawSurface | sanitizeSurface %}
{% set siteUrl = 'https://kirche-echo.de' %}
{% set campusSuffix = '' %}
{% if currentSurface == 'gifhorn' %}{% set campusSuffix = ' Gifhorn' %}
{% elif currentSurface == 'wolfsburg' %}{% set campusSuffix = ' Wolfsburg' %}
{% elif currentSurface == 'helmstedt' %}{% set campusSuffix = ' Helmstedt' %}
{% elif currentSurface == 'instagram' %}{% set campusSuffix = ' Instagram' %}
{% endif %}
{% set defaultSocialTitle = (site.profile.name or 'Echo Kirche') + campusSuffix + ' – Quick-Links' %}
{% set pageTitle = title or (storyblok.content.title if (storyblok and storyblok.content and storyblok.content.title and storyblok.content.title != (site.profile.name or 'Echo Kirche')) else defaultSocialTitle) %}
{% set defaultDesc = 'Alle wichtigen Links, Gottesdienste, Termine und Angebote der Echo Kirche auf einen Blick.' %}
{% if currentSurface == 'gifhorn' %}{% set defaultDesc = 'Alle wichtigen Links, Gottesdienste und Angebote der Echo Kirche Gifhorn auf einen Blick.' %}
{% elif currentSurface == 'wolfsburg' %}{% set defaultDesc = 'Alle wichtigen Links, Gottesdienste und Angebote der Echo Kirche Wolfsburg auf einen Blick.' %}
{% elif currentSurface == 'helmstedt' %}{% set defaultDesc = 'Alle wichtigen Links, Gottesdienste und Angebote der Echo Kirche Helmstedt auf einen Blick.' %}
{% elif currentSurface == 'instagram' %}{% set defaultDesc = 'Alle wichtigen Links, Aktionen und Infos der Echo Kirche auf Instagram.' %}
{% elif is404 %}{% set defaultDesc = 'Diese Seite konnte leider nicht gefunden werden.' %}
{% endif %}
{% set pageDescription = description or (storyblok.content.description if (storyblok and storyblok.content and storyblok.content.description) else (site.profile.bio if (site.profile and site.profile.bio) else defaultDesc)) %}
{% set canonicalUrl = siteUrl + (page.url or '/') %}
{% set logoPath = (site.profile.avatar.filename if (site.profile and site.profile.avatar and site.profile.avatar.filename) else (site.profile.avatar if (site.profile and site.profile.avatar) else '/assets/images/logo.svg')) %}
{% set rawSocialImage = ogImage or (storyblok.content.og_image.filename if (storyblok and storyblok.content and storyblok.content.og_image and storyblok.content.og_image.filename) else logoPath) %}
{% set socialImage = rawSocialImage if (rawSocialImage and rawSocialImage.indexOf('http') == 0) else (siteUrl + rawSocialImage) %}
{% set socialImageType = 'image/svg+xml' %}
{% if '.webp' in socialImage %}{% set socialImageType = 'image/webp' %}
{% elif '.png' in socialImage %}{% set socialImageType = 'image/png' %}
{% elif '.jpg' in socialImage or '.jpeg' in socialImage %}{% set socialImageType = 'image/jpeg' %}
{% endif %}
<!DOCTYPE html>
<!-- Created with ❤️ : The Missional Company (missional.eu) -->
<html lang="de" data-surface="{{ currentSurface }}" data-theme="{{ currentTheme }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ canonicalUrl }}">

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="de_DE">
  <meta property="og:site_name" content="{{ site.profile.name or 'Echo Kirche' }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta property="og:image:alt" content="{{ site.profile.name or 'Echo Kirche' }} Logo">
  <meta property="og:image:type" content="{{ socialImageType }}">

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ socialImage }}">
  <meta name="twitter:image:alt" content="{{ site.profile.name or 'Echo Kirche' }} Logo">

  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="{{ '#000000' if currentTheme == 'dark' else ('#08415C' if currentTheme == 'teal' else ('#846B8A' if currentTheme == 'lavender' else ('#FEFADC' if (currentTheme == 'pale' or currentTheme == 'warm') else '#FFFFFF'))) }}">
  {% if is404 %}
  <meta http-equiv="refresh" content="0; url=/">
  {% endif %}
  <link rel="icon" type="image/webp" href="/assets/images/favicon.webp">
  <link rel="preload" href="/assets/fonts/ClashDisplay-Semibold.ttf" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <a href="#content" class="a11y-button a11y-button--skip">
    <span class="a11y-button__icon" aria-hidden="true">
      <svg class="fa-svg fa-arrow-down" viewBox="0 0 384 512" fill="currentColor" width="16" height="16"><path d="M169.4 470.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 370.8 224 64c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 306.7L54.6 265.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z"/></svg>
    </span>
    <span class="a11y-button__label">Zum Hauptinhalt springen</span>
  </a>
  {{ content | safe }}
  <button type="button" class="a11y-button a11y-button--floating" id="a11y-trigger" aria-haspopup="dialog" aria-controls="a11y-modal" aria-label="Barrierefreiheit Optionen öffnen">
    <span class="a11y-button__icon" aria-hidden="true">
      <svg class="fa-svg fa-universal-access" viewBox="0 0 512 512" fill="currentColor" width="16" height="16"><path d="M256 48a48 48 0 1 1 0 96 48 48 0 1 1 0-96zm-41.6 112h83.2c19.4 0 37.3 10.7 46.5 27.8l56 104c9 16.7 3 37.6-13.7 46.6s-37.6 3-46.6-13.7l-35.8-66.5v89.7l46.2 138.6c5.6 16.8-3.7 35.1-20.5 40.7s-35.1-3.7-40.7-20.5L256 400.9l-26.9 105.8c-5.6 16.8-23.9 26.1-40.7 20.5s-26.1-23.9-20.5-40.7l46.2-138.6v-89.7l-35.8 66.5c-9 16.7-29.9 22.7-46.6 13.7s-22.7-29.9-13.7-46.6l56-104c9.2-17.1 27.1-27.8 46.5-27.8z"/></svg>
    </span>
    <span class="a11y-button__label">Barrierefreiheit</span>
  </button>

  <dialog class="a11y-modal" id="a11y-modal" aria-labelledby="a11y-modal-title">
    <div class="a11y-modal__dialog">
      <header class="a11y-modal__header">
        <h2 class="a11y-modal__title" id="a11y-modal-title">
          <span class="a11y-modal__title-icon" aria-hidden="true">
            <svg class="fa-svg fa-universal-access" viewBox="0 0 512 512" fill="currentColor" width="20" height="20"><path d="M256 48a48 48 0 1 1 0 96 48 48 0 1 1 0-96zm-41.6 112h83.2c19.4 0 37.3 10.7 46.5 27.8l56 104c9 16.7 3 37.6-13.7 46.6s-37.6 3-46.6-13.7l-35.8-66.5v89.7l46.2 138.6c5.6 16.8-3.7 35.1-20.5 40.7s-35.1-3.7-40.7-20.5L256 400.9l-26.9 105.8c-5.6 16.8-23.9 26.1-40.7 20.5s-26.1-23.9-20.5-40.7l46.2-138.6v-89.7l-35.8 66.5c-9 16.7-29.9 22.7-46.6 13.7s-22.7-29.9-13.7-46.6l56-104c9.2-17.1 27.1-27.8 46.5-27.8z"/></svg>
          </span>
          Barrierefreiheit &amp; Anzeige
        </h2>
        <button type="button" class="a11y-modal__close" id="a11y-modal-close" aria-label="Schließen">&times;</button>
      </header>

      <div class="a11y-modal__body">
        <section class="a11y-modal__section" aria-labelledby="a11y-font-label">
          <span class="a11y-modal__label" id="a11y-font-label">Schriftgröße:</span>
          <div class="a11y-modal__options" role="toolbar" aria-label="Schriftgröße Optionen">
            <button type="button" class="a11y-modal__btn is-active" data-font-size-value="normal" aria-pressed="true">Standard (100%)</button>
            <button type="button" class="a11y-modal__btn" data-font-size-value="large" aria-pressed="false">Groß (115%)</button>
            <button type="button" class="a11y-modal__btn" data-font-size-value="xlarge" aria-pressed="false">Sehr groß (130%)</button>
          </div>
        </section>

        <section class="a11y-modal__section" aria-labelledby="a11y-contrast-label">
          <span class="a11y-modal__label" id="a11y-contrast-label">Hoher Kontrast:</span>
          <div class="a11y-modal__options" role="toolbar" aria-label="Kontrast Optionen">
            <button type="button" class="a11y-modal__btn is-active" data-contrast-value="normal" aria-pressed="true">Standard</button>
            <button type="button" class="a11y-modal__btn" data-contrast-value="black-on-white" aria-pressed="false">Schwarz auf Weiß</button>
            <button type="button" class="a11y-modal__btn" data-contrast-value="white-on-black" aria-pressed="false">Weiß auf Schwarz</button>
          </div>
        </section>
      </div>
    </div>
  </dialog>
  <script src="/assets/js/video-embed.js" defer></script>
  <script src="/assets/js/surface-switcher.js" defer></script>
  <script src="/assets/js/clipboard-copy.js" defer></script>
</body>
</html>
