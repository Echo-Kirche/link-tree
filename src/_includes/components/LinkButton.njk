{% set resolvedUrl = item.url | resolveUrl %}
<a class="link-button{% if item.icon and item.icon != '' %} link-button--with-icon{% endif %}" href="{{ resolvedUrl }}" rel="noopener noreferrer">
  {% if item.icon and item.icon != '' %}
  <span class="link-button__icon" aria-hidden="true">
    {% set iconName = item.icon %}
    {% include "components/FaIcon.njk" %}
  </span>
  {% endif %}
  <span class="link-button__label">{{ item.label }}</span>
</a>
