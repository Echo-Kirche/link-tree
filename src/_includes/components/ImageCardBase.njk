{% set resolvedCardUrl = item.url | resolveUrl %}
{% set primaryImg = "" %}
{% if item.image %}
  {% if item.image is string %}
    {% set primaryImg = item.image | trim %}
  {% elif item.image.filename %}
    {% set primaryImg = item.image.filename | trim %}
  {% elif item.image.src %}
    {% set primaryImg = item.image.src | trim %}
  {% endif %}
{% endif %}
{% set fallbackRaw = item.image_url or item.imageUrl or "" %}
{% set fallbackImg = "" %}
{% if fallbackRaw %}
  {% if fallbackRaw is string %}
    {% set fallbackImg = fallbackRaw | trim %}
  {% elif fallbackRaw.url %}
    {% set fallbackImg = fallbackRaw.url | trim %}
  {% elif fallbackRaw.cached_url %}
    {% set fallbackImg = fallbackRaw.cached_url | trim %}
  {% elif fallbackRaw.filename %}
    {% set fallbackImg = fallbackRaw.filename | trim %}
  {% endif %}
{% endif %}
{% set rawImgSrc = primaryImg if primaryImg else fallbackImg %}
{% set imgSrc = "" %}
{% if rawImgSrc %}
  {% set checkedImgSrc = rawImgSrc | resolveUrl %}
  {% if checkedImgSrc and checkedImgSrc != "#" %}
    {% set imgSrc = checkedImgSrc %}
  {% endif %}
{% endif %}
{% set imgAlt = (item.image.alt if (primaryImg and item.image and item.image.alt) else "") or item.label or "" %}
{% set imgWidth = item.image.width if (primaryImg and item.image and item.image.width) else defaultWidth %}
{% set imgHeight = item.image.height if (primaryImg and item.image and item.image.height) else defaultHeight %}
<a class="image-card image-card--{{ imageCardVariant }}" href="{{ resolvedCardUrl }}" rel="noopener noreferrer">
  {% if imgSrc %}
  <div class="image-card__media">
    <img src="{{ imgSrc }}" alt="{{ imgAlt }}" width="{{ imgWidth }}" height="{{ imgHeight }}" loading="lazy" />
  </div>
  {% endif %}
  {% if item.label %}
  <div class="image-card__content">
    <span class="image-card__title">{{ item.label }}</span>
    <span class="image-card__arrow" aria-hidden="true">
      <svg class="fa-svg fa-arrow-right" viewBox="0 0 448 512" fill="currentColor" width="16" height="16">
        <path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0-105.4 105.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/>
      </svg>
    </span>
  </div>
  {% endif %}
</a>
