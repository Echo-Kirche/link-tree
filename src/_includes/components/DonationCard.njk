<details class="donation-card"{% if item._editable %} {{ item | storyblokEditable | safe }}{% endif %}>
  <summary class="donation-card__summary link-button{% if item.icon and item.icon != '' %} link-button--with-icon{% endif %}">
    {% if item.icon and item.icon != '' %}
    <span class="link-button__icon" aria-hidden="true">
      {% if item.icon == "heart" or item.icon == "spenden" or item.icon == "give" %}
      <svg class="fa-svg fa-heart" viewBox="0 0 512 512" fill="currentColor" width="18" height="18"><path d="M47.6 300.4L228.3 469.1c7.5 7 17.4 10.9 27.7 10.9s20.2-3.9 27.7-10.9L464.4 300.4c30.4-28.3 47.6-68 47.6-109.5v-5.8c0-69.9-50.5-129.5-119.4-141C347 36.5 300.6 51.4 268 84L256 96 244 84c-32.6-32.6-79-47.5-124.6-39.9C50.5 55.6 0 115.2 0 185.1v5.8c0 41.5 17.2 81.2 47.6 109.5z"/></svg>
      {% elif item.icon == "church" or item.icon == "fa-church" %}
      <svg class="fa-svg fa-church" viewBox="0 0 576 512" fill="currentColor" width="18" height="18"><path d="M576 448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64s28.7-64 64-64v-64c0-35.3 28.7-64 64-64h48v-32c0-17.7 14.3-32 32-32h16V64h-16c-8.8 0-16-7.2-16-16s7.2-16 16-16h16V16c0-8.8 7.2-16 16-16s16 7.2 16 16v16h16c8.8 0 16 7.2 16 16s-7.2 16-16 16h-16v128h16c17.7 0 32 14.3 32 32v32h48c35.3 0 64 28.7 64 64v64c35.3 0 64 28.7 64 64zM240 352v96h96v-96c0-26.5-21.5-48-48-48s-48 21.5-48 48z"/></svg>
      {% elif item.icon == "calendar" or item.icon == "fa-calendar" or item.icon == "events" %}
      <svg class="fa-svg fa-calendar" viewBox="0 0 448 512" fill="currentColor" width="18" height="18"><path d="M128 0c17.7 0 32 14.3 32 32V64H288V32c0-17.7 14.3-32 32-32s32 14.3 32 32V64h48c26.5 0 48 21.5 48 48v48H0V112C0 85.5 21.5 64 48 64H96V32c0-17.7 14.3-32 32-32zM0 192H448V464c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V192zm64 80c-8.8 0-16 7.2-16 16v48c0 8.8 7.2 16 16 16h48c8.8 0 16-7.2 16-16V288c0-8.8-7.2-16-16-16H64zm128 0c-8.8 0-16 7.2-16 16v48c0 8.8 7.2 16 16 16h48c8.8 0 16-7.2 16-16V288c0-8.8-7.2-16-16-16H192zm144 0c-8.8 0-16 7.2-16 16v48c0 8.8 7.2 16 16 16h48c8.8 0 16-7.2 16-16V288c0-8.8-7.2-16-16-16H336z"/></svg>
      {% elif item.icon == "users" or item.icon == "fa-users" %}
      <svg class="fa-svg fa-users" viewBox="0 0 640 512" fill="currentColor" width="18" height="18"><path d="M144 0a80 80 0 1 1 0 160A80 80 0 1 1 144 0zM512 0a80 80 0 1 1 0 160A80 80 0 1 1 512 0zM0 298.7C0 239.8 47.8 192 106.7 192h74.7c58.9 0 106.7 47.8 106.7 106.7V352H0v-53.3zM352 352v-53.3c0-58.9 47.8-106.7 106.7-106.7h74.7c58.9 0 106.7 47.8 106.7 106.7V352H352zm64 64H224v96h192v-96z"/></svg>
      {% elif item.icon == "location" or item.icon == "map-pin" %}
      <svg class="fa-svg fa-location-dot" viewBox="0 0 384 512" fill="currentColor" width="18" height="18"><path d="M384 192c0 87.4-117 243-168.3 307.2-12.3 15.3-35.1 15.3-47.4 0C117 435 0 279.4 0 192 0 86 86 0 192 0s192 86 192 192zm-192 96a96 96 0 1 0 0-192 96 96 0 1 0 0 192z"/></svg>
      {% else %}
      <svg class="fa-svg fa-heart" viewBox="0 0 512 512" fill="currentColor" width="18" height="18"><path d="M47.6 300.4L228.3 469.1c7.5 7 17.4 10.9 27.7 10.9s20.2-3.9 27.7-10.9L464.4 300.4c30.4-28.3 47.6-68 47.6-109.5v-5.8c0-69.9-50.5-129.5-119.4-141C347 36.5 300.6 51.4 268 84L256 96 244 84c-32.6-32.6-79-47.5-124.6-39.9C50.5 55.6 0 115.2 0 185.1v5.8c0 41.5 17.2 81.2 47.6 109.5z"/></svg>
      {% endif %}
    </span>
    {% endif %}
    <span class="link-button__label">{{ item.label }}</span>
    <span class="donation-card__chevron" aria-hidden="true">
      <svg class="fa-svg fa-chevron-down" viewBox="0 0 448 512" fill="currentColor" width="14" height="14"><path d="M201.4 342.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 274.7 86.6 137.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z"/></svg>
    </span>
  </summary>

  <div class="donation-card__content">
    {% if item.description %}
    <p class="donation-card__description">{{ item.description }}</p>
    {% endif %}

    {% set resolvedPaypalUrl = (item.paypalUrl or item.paypal_url) | resolveUrl %}
    {% set resolvedIbanLinkUrl = (item.ibanLinkUrl or item.iban_link_url) | resolveUrl %}

    {% if (resolvedPaypalUrl and resolvedPaypalUrl != '#') or (resolvedIbanLinkUrl and resolvedIbanLinkUrl != '#') %}
    <div class="donation-card__actions">
      {% if resolvedPaypalUrl and resolvedPaypalUrl != '#' %}
      <a class="donation-card__btn donation-card__btn--paypal" href="{{ resolvedPaypalUrl }}" target="_blank" rel="noopener noreferrer">
        <span class="donation-card__btn-icon" aria-hidden="true">
          <svg class="fa-svg fa-paypal" viewBox="0 0 384 512" fill="currentColor" width="18" height="18"><path d="M111.4 295.9c-3.5 19.2-17.4 108.7-21.5 134-.3 1.8-1 2.5-3 2.5H12.3c-7.6 0-13.1-6.6-12.1-13.9L58.8 46.6c1.5-9.6 10.1-16.9 20-16.9 152.3 0 165.1-3.7 204 45.4 26.2 33 22.8 77.8 7.3 112.5-18.7 41.9-56 68.6-104.9 76.5-6.9 1.1-11.8 7-10.7 13.8l7.9 44.5c.9 5.8-3.4 11-9.3 11.2l-69.7 2.3z"/></svg>
        </span>
        <span class="donation-card__btn-label">{{ item.paypalLabel or item.paypal_label or "Mit PayPal spenden" }}</span>
        <span class="donation-card__btn-arrow" aria-hidden="true">&rarr;</span>
      </a>
      {% endif %}

      {% if resolvedIbanLinkUrl and resolvedIbanLinkUrl != '#' %}
      <a class="donation-card__btn donation-card__btn--iban" href="{{ resolvedIbanLinkUrl }}" rel="noopener noreferrer">
        <span class="donation-card__btn-icon" aria-hidden="true">
          <svg class="fa-svg fa-building-columns" viewBox="0 0 512 512" fill="currentColor" width="18" height="18"><path d="M240 32c17.7 0 32 14.3 32 32V96h176c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H208V64c0-17.7 14.3-32 32-32zM32 192H96v192H32V192zm160 0h64v192H192V192zm224 0h64v192H416V192zM0 448c0-17.7 14.3-32 32-32H480c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32z"/></svg>
        </span>
        <span class="donation-card__btn-label">{{ item.ibanLinkLabel or item.iban_link_label or "Online-Banking öffnen" }}</span>
        <span class="donation-card__btn-arrow" aria-hidden="true">&rarr;</span>
      </a>
      {% endif %}
    </div>
    {% endif %}

    {% set accountName = item.accountName or item.account_name %}
    {% set ibanNumber = item.iban %}
    {% set bicCode = item.bic %}
    {% set bankName = item.bankName or item.bank_name %}
    {% set ibanTitle = item.ibanTitle or item.iban_title or "Per Banküberweisung (IBAN)" %}
    {% set copyLabel = item.copyLabel or item.copy_label or "IBAN kopieren" %}
    {% set referenceText = item.reference %}

    {% if ibanNumber or accountName %}
    <div class="donation-card__bank-card">
      <div class="donation-card__bank-header">
        <span class="donation-card__bank-icon" aria-hidden="true">
          <svg class="fa-svg fa-credit-card" viewBox="0 0 576 512" fill="currentColor" width="18" height="18"><path d="M0 112c0-26.5 21.5-48 48-48h480c26.5 0 48 21.5 48 48v48H0V112zm0 128h576v160c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V240zm64 96c-8.8 0-16 7.2-16 16s7.2 16 16 16h64c8.8 0 16-7.2 16-16s-7.2-16-16-16H64zm128 0c-8.8 0-16 7.2-16 16s7.2 16 16 16h128c8.8 0 16-7.2 16-16s-7.2-16-16-16H192z"/></svg>
        </span>
        <strong class="donation-card__bank-title">{{ ibanTitle }}</strong>
      </div>

      <dl class="donation-card__bank-details">
        {% if accountName %}
        <div class="donation-card__detail-row">
          <dt class="donation-card__detail-label">Kontoinhaber</dt>
          <dd class="donation-card__detail-value">{{ accountName }}</dd>
        </div>
        {% endif %}

        {% if ibanNumber %}
        <div class="donation-card__detail-row donation-card__detail-row--iban">
          <dt class="donation-card__detail-label">IBAN</dt>
          <dd class="donation-card__detail-value">
            <code class="donation-card__iban-code">{{ ibanNumber }}</code>
          </dd>
        </div>
        {% endif %}

        {% if bicCode %}
        <div class="donation-card__detail-row">
          <dt class="donation-card__detail-label">BIC / SWIFT</dt>
          <dd class="donation-card__detail-value">{{ bicCode }}</dd>
        </div>
        {% endif %}

        {% if bankName %}
        <div class="donation-card__detail-row">
          <dt class="donation-card__detail-label">Bankinstitut</dt>
          <dd class="donation-card__detail-value">{{ bankName }}</dd>
        </div>
        {% endif %}

        {% if referenceText %}
        <div class="donation-card__detail-row">
          <dt class="donation-card__detail-label">Verwendungszweck</dt>
          <dd class="donation-card__detail-value">{{ referenceText }}</dd>
        </div>
        {% endif %}
      </dl>

      {% if ibanNumber %}
      <div class="donation-card__copy-wrapper">
        <button type="button" class="donation-card__copy-btn" data-copy-iban="{{ ibanNumber }}" data-copied-text="IBAN kopiert!" data-default-label="{{ copyLabel }}" aria-label="{{ copyLabel }}">
          <span class="donation-card__copy-icon donation-card__copy-icon--copy" aria-hidden="true">
            <svg class="fa-svg fa-copy" viewBox="0 0 448 512" fill="currentColor" width="16" height="16"><path d="M384 336H192c-8.8 0-16-7.2-16-16V64c0-8.8 7.2-16 16-16l140.1 0L384 99.9V320c0 8.8-7.2 16-16 16zM192 0C156.7 0 128 28.7 128 64V320c0 35.3 28.7 64 64 64H384c35.3 0 64-28.7 64-64V96c0-17-6.7-33.3-18.7-45.3L381.3 18.7C369.3 6.7 353 0 336 0H192zM64 128c-35.3 0-64 28.7-64 64V448c0 35.3 28.7 64 64 64H256c35.3 0 64-28.7 64-64V416H272v32c0 8.8-7.2 16-16 16H64c-8.8 0-16-7.2-16-16V192c0-8.8 7.2-16 16-16h32V128H64z"/></svg>
          </span>
          <span class="donation-card__copy-icon donation-card__copy-icon--check" aria-hidden="true">
            <svg class="fa-svg fa-check" viewBox="0 0 448 512" fill="currentColor" width="16" height="16"><path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"/></svg>
          </span>
          <span class="donation-card__copy-text">{{ copyLabel }}</span>
        </button>
        <span class="donation-card__live-region sr-only" aria-live="polite"></span>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
</details>
