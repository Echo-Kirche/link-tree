---
layout: layouts/base.njk
permalink: "/test/index.html"
eleventyComputed:
  surface: "all"
---
<div class="linktree-shell"{% if storyblok and storyblok.content %} {{ storyblok.content | storyblokEditable | safe }}{% endif %}>
  {% if storyblok and storyblok.content and storyblok.content.profile and storyblok.content.profile[0] %}
    {% set profile = storyblok.content.profile[0] %}
  {% else %}
    {% set profile = site.profile %}
  {% endif %}
  {% include "components/ProfileHeader.njk" %}

  <main class="linktree-main" id="content">
    <nav class="surface-switcher" aria-label="Standort und Kanal Switcher">
      <span class="surface-switcher__label">Switches / Filter testen:</span>
      <div class="surface-switcher__group" role="toolbar" aria-label="Switch Optionen">
        <a class="surface-switcher__btn" href="?surface=default" data-switch-value="default" role="button" aria-pressed="false">Alle</a>
        <a class="surface-switcher__btn" href="?surface=gifhorn" data-switch-value="gifhorn" role="button" aria-pressed="false">Gifhorn (/gf, /gifhorn)</a>
        <a class="surface-switcher__btn" href="?surface=wolfsburg" data-switch-value="wolfsburg" role="button" aria-pressed="false">Wolfsburg (/wob, /wolfsburg)</a>
        <a class="surface-switcher__btn" href="?surface=helmstedt" data-switch-value="helmstedt" role="button" aria-pressed="false">Helmstedt (/he, /helmstedt)</a>
        <a class="surface-switcher__btn" href="?surface=instagram" data-switch-value="instagram" role="button" aria-pressed="false">Instagram (/ig, /instagram)</a>
      </div>
      <div class="surface-switcher__status" aria-live="polite">
        Aktiver Switch: <strong id="active-switch-badge">default</strong>
      </div>
    </nav>

    <nav class="theme-switcher surface-switcher" aria-label="Theme Switcher">
      <span class="surface-switcher__label">Themes testen:</span>
      <div class="surface-switcher__group" role="toolbar" aria-label="Theme Optionen">
        <button type="button" class="surface-switcher__btn" data-theme-value="light" aria-pressed="false">Light / White</button>
        <button type="button" class="surface-switcher__btn" data-theme-value="pale" aria-pressed="false">Pale / Buttergelb</button>
        <button type="button" class="surface-switcher__btn" data-theme-value="soft" aria-pressed="false">Soft</button>
        <button type="button" class="surface-switcher__btn" data-theme-value="dark" aria-pressed="false">Dark</button>
        <button type="button" class="surface-switcher__btn" data-theme-value="teal" aria-pressed="false">Teal</button>
        <button type="button" class="surface-switcher__btn" data-theme-value="lavender" aria-pressed="false">Lavender</button>
      </div>
      <div class="surface-switcher__status" aria-live="polite">
        Aktives Theme: <strong id="active-theme-badge">light</strong>
      </div>
    </nav>

    <section class="surface-switcher a11y-test-section" aria-label="Accessibility Komponenten Test">
      <span class="surface-switcher__label">Accessibility (a11y) Button Test:</span>
      <div class="surface-switcher__group" role="toolbar" aria-label="Accessibility Buttons">
        <a href="#content" class="a11y-button">
          <span class="a11y-button__icon" aria-hidden="true">
            <svg class="fa-svg fa-arrow-down" viewBox="0 0 384 512" fill="currentColor" width="16" height="16"><path d="M169.4 470.6c12.5 12.5 32.8 12.5 45.3 0l160-160c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 370.8 224 64c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 306.7L54.6 265.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l160 160z"/></svg>
          </span>
          <span class="a11y-button__label">Zum Inhalt springen (Primary)</span>
        </a>
        <button type="button" class="a11y-button a11y-button--secondary">
          <span class="a11y-button__icon" aria-hidden="true">
            <svg class="fa-svg fa-contrast" viewBox="0 0 512 512" fill="currentColor" width="16" height="16"><path d="M448 256c0-106-86-192-192-192V448c106 0 192-86 192-192zM0 256a256 256 0 1 1 512 0A256 256 0 1 1 0 256z"/></svg>
          </span>
          <span class="a11y-button__label">Kontrast Toggle (Secondary)</span>
        </button>
        <button type="button" class="a11y-button a11y-button--surface" id="a11y-test-modal-trigger" aria-haspopup="dialog" aria-controls="a11y-modal">
          <span class="a11y-button__icon" aria-hidden="true">
            <svg class="fa-svg fa-universal-access" viewBox="0 0 512 512" fill="currentColor" width="16" height="16"><path d="M256 48a48 48 0 1 1 0 96 48 48 0 1 1 0-96zm-41.6 112h83.2c19.4 0 37.3 10.7 46.5 27.8l56 104c9 16.7 3 37.6-13.7 46.6s-37.6 3-46.6-13.7l-35.8-66.5v89.7l46.2 138.6c5.6 16.8-3.7 35.1-20.5 40.7s-35.1-3.7-40.7-20.5L256 400.9l-26.9 105.8c-5.6 16.8-23.9 26.1-40.7 20.5s-26.1-23.9-20.5-40.7l46.2-138.6v-89.7l-35.8 66.5c-9 16.7-29.9 22.7-46.6 13.7s-22.7-29.9-13.7-46.6l56-104c9.2-17.1 27.1-27.8 46.5-27.8z"/></svg>
          </span>
          <span class="a11y-button__label">Barrierefreiheit Popup (Surface)</span>
        </button>
      </div>
    </section>

    {% set rawItems = storyblok.content.body if (storyblok and storyblok.content and storyblok.content.body) else site.links %}
    {% set visibleLinks = rawItems | filterBySurface('all') %}
    <ul class="linktree-list" role="list">
      {% for item in visibleLinks %}
      <li class="linktree-item" data-uid="{{ item._uid or item.id }}"{% if item.showOn or item.show_on %} data-show-on="{{ (item.showOn or item.show_on) | join(',') }}"{% endif %}{% if item.hideOn or item.hide_on %} data-hide-on="{{ (item.hideOn or item.hide_on) | join(',') }}"{% endif %}{% if item.displayInDefault !== undefined %} data-display-in-default="{{ item.displayInDefault }}"{% elif item.display_in_default !== undefined %} data-display-in-default="{{ item.display_in_default }}"{% endif %}{% if item._editable %} {{ item | storyblokEditable | safe }}{% endif %}>
        {% if item.component == "group_block" or item.component == "content_block" or item.type == "group-block" %}
          {% include "components/GroupBlock.njk" %}
        {% elif item.component == "link_button" or item.type == "link" %}
          {% include "components/LinkButton.njk" %}
        {% elif item.component == "image_card_horizontal" or item.type == "image-horizontal" %}
          {% include "components/ImageCardHorizontal.njk" %}
        {% elif item.component == "image_card_vertical" or item.type == "image-vertical" %}
          {% include "components/ImageCardVertical.njk" %}
        {% elif item.component == "video_link_card" or item.type == "video-link" %}
          {% include "components/VideoLinkCard.njk" %}
        {% elif item.component == "section_heading" or item.type == "section-heading" %}
          {% include "components/SectionHeading.njk" %}
        {% elif item.component == "dropdown_card" or item.type == "dropdown-card" %}
          {% include "components/DropdownCard.njk" %}
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </main>

  {% set rawFooters = storyblok.content.footer if (storyblok and storyblok.content and storyblok.content.footer and storyblok.content.footer.length) else footers %}
  {% set visibleFooters = rawFooters | filterBySurface('all') %}
  {% for footerBlok in visibleFooters %}
    {% include "components/FooterLegal.njk" %}
  {% endfor %}
</div>
